<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F8FB3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="AquaWatch"
                android:fontFamily="@font/poppins_medium"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="👤"
                android:background="@drawable/rounded_input"
                android:backgroundTint="@color/white"
                android:textColor="#1F8FB3"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnAlerts"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🔔"
                android:background="@drawable/rounded_input"
                android:backgroundTint="@color/white"
                android:textColor="#1F8FB3" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Water Monitoring Dashboard"
            android:fontFamily="@font/poppins_medium"
            android:textSize="16sp"
            android:textColor="#E0F7FA"
            android:layout_marginBottom="20dp"/>

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/water_level_icon"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvWaterLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Water Level: 0%"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <ProgressBar
            android:id="@+id/progressWater"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="250dp"
            android:layout_height="16dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Status: MEDIUM"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LED Indicator"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Low"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#FF4C4C"
            android:textSize="14sp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Medium"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Full"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#00E676"
            android:textSize="14sp"/>

    </LinearLayout>
        <Button
            android:id="@+id/btnSimulate"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Refresh"
            android:fontFamily="@font/poppins_medium"
            android:backgroundTint="#FFFFFF"
            android:textColor="#1F8FB3"/>

    </LinearLayout>

</ScrollView>