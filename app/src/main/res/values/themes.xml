<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AquaWatch" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color aligned with Aqua blue background. -->
        <item name="colorPrimary">#1F8FB3</item>
        <item name="colorPrimaryVariant">#166885</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/white</item>
        <item name="colorSecondaryVariant">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
</resources>